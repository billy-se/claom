{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open Frontend Terminal",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/core/frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      },
      "runOptions": { "runOn": "folderOpen" }
    },
    {
      "label": "Backend",
      "type": "shell",
      "command": "go run .",
      "options": {
        "cwd": "${workspaceFolder}/core/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      },
      "runOptions": { "runOn": "folderOpen" }
    },
    {
      "label": "Postgres",
      "type": "shell",
      "command": "psql -U postgres",
      "options": {
        "cwd": "${workspaceFolder}/core/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      },
      "runOptions": { "runOn": "folderOpen" }
    }
  ]
}